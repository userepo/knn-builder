# Fixtures are byte-exact test inputs: never apply line-ending conversion,
# whatever a clone's core.autocrlf says.
fixtures/** -text

# Shell scripts break with CRLF line endings, which a Windows clone with
# core.autocrlf=true would give them, and they are run from such clones
# under WSL.
*.sh text eol=lf

# The recorded metrics page is compared with the renderer's output to the
# byte, and that output ends its lines with LF on every platform.
crates/knn-builder/tests/data/metrics.txt text eol=lf
